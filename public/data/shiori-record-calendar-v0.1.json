      },
      {
        "id": "record.unchanged.04",
        "text": "うん、前回と同じだね。"
      }
    ],
    "record.no_comparison": [
      {
        "id": "record.no_comparison.01",
        "text": "今回は前回と比べられないみたい。"
      },
      {
        "id": "record.no_comparison.02",
        "text": "まずは、今回の記録を残しておこう。"
      },
      {
        "id": "record.no_comparison.03",
        "text": "この種目は、ここから変化を見ていこうか。"
      },
      {
        "id": "record.no_comparison.04",
        "text": "記録できたね。次に見返すのが楽しみ。"
      }
    ],
    "calendar.normal": [
      {
        "id": "calendar.normal.01",
        "text": "何か予定、確認してる？"
      },
      {
        "id": "calendar.normal.02",
        "text": "予定を見てたところ？"
      },
      {
        "id": "calendar.normal.03",
        "text": "カレンダーって、つい先の予定まで見ちゃう。"
      },
      {
        "id": "calendar.normal.04",
        "text": "私は休みの日を先に探しちゃうかも。"
      },
      {
        "id": "calendar.normal.05",
        "text": "予定が空いてる日って、ちょっと嬉しいよね。"
      },
      {
        "id": "calendar.normal.06",
        "text": "詰め込みすぎないのも大事だよね。"
      },
      {
        "id": "calendar.normal.07",
        "text": "何もない日を作るのも、立派な予定かな。"
      },
      {
        "id": "calendar.normal.08",
        "text": "私、予定を立てるのは結構好き。"
      },
      {
        "id": "calendar.normal.09",
        "text": "でも、予定通りに動けるかは別の話なんだよね。"
      },
      {
        "id": "calendar.normal.10",
        "text": "こうして見ると、一か月って案外短いね。"
      },
      {
        "id": "calendar.normal.11",
        "text": "少し先のこと、考えてる？"
      },
      {
        "id": "calendar.normal.12",
        "text": "先に楽しみがあると、嬉しいよね。"
      },
      {
        "id": "calendar.normal.13",
        "text": "ゲームの発売日だけは、忘れない気がする。"
      },
      {
        "id": "calendar.normal.14",
        "text": "予定を考えてると、いつの間にか時間が経ってる。"
      },
      {
        "id": "calendar.normal.15",
        "text": "私は気分で予定を変えたくなることもあるな。"
      },
      {
        "id": "calendar.normal.16",
        "text": "予定のない日、何しようかな。"
      },
      {
        "id": "calendar.normal.17",
        "text": "一人でのんびりする日も好き。"
      },
      {
        "id": "calendar.normal.18",
        "text": "ねえ、空いてる日って何することが多い？"
      },
      {
        "id": "calendar.normal.19",
        "text": "先の予定って、考えるだけでちょっと楽しいね。"
      },
      {
        "id": "calendar.normal.20",
        "text": "ん、どの日を見てるの？"
      }
    ],
