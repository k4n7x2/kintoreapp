{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kintoreapp",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kintore-db",
      "database_id": "YOUR_D1_DATABASE_UUID"
    }
  ]
}
